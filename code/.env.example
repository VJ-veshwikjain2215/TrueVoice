# TrueVoice Environment Configuration Template
# Copy this file to .env and replace placeholder values.
# NEVER commit real API keys or credentials to the repository.

# Server Configuration
PORT=8080
HOST=127.0.0.1
NODE_ENV=production

# Optional Groq Cloud Intelligence API (for semantic transcript analysis)
# Replace with your actual key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Local Storage / Model Checkpoints
ONNX_MODELS_DIR=app/src/main/assets/models
AUDIO_CACHE_DIR=audio
